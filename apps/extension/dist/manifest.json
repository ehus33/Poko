{
  "manifest_version": 3,
  "name": "Poko",
  "version": "0.1.0",
  "description": "Pause checkout pressure and provide calmer buying flows.",
  "action": {
    "default_title": "Poko",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
